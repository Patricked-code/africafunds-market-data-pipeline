# Template only. NEVER commit the real /etc/sadiaaf-market-data-staging.env.
# Password must be generated as 64 lowercase hexadecimal characters:
#   openssl rand -hex 32
# Replace BOTH password placeholders with the same generated value.
# The installer rejects placeholders and production DB names.
NODE_ENV=production
POSTGRES_DB=sadiaaf_market_staging
POSTGRES_USER=sadiaaf_staging
POSTGRES_PASSWORD=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
DATABASE_URL=postgresql://sadiaaf_staging:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS@postgres:5432/sadiaaf_market_staging
RAW_ARCHIVE_DIR=/app/data/raw
SOURCE_REGISTRY_PATH=/app/config/sources.json
LOG_LEVEL=info
ENABLE_SCHEDULER=false
API_HOST=0.0.0.0
API_PORT=8080
API_BIND_PORT=18991
WEB_BIND_PORT=18992
DASHBOARD_ORIGINS=http://127.0.0.1:18992
SCHEDULER_TIMEZONE=Europe/Paris
BACKFILL_BATCH_DAYS=90
MAX_CONCURRENT_SOURCES=1
HTTP_TIMEOUT_MS=45000
HTTP_MAX_RETRIES=4

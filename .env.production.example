NODE_ENV=production
POSTGRES_DB=africafunds_market
POSTGRES_USER=africafunds
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://africafunds:CHANGE_ME_WITH_A_LONG_RANDOM_SECRET@postgres:5432/africafunds_market
RAW_ARCHIVE_DIR=/app/data/raw
SOURCE_REGISTRY_PATH=/app/config/sources.json
LOG_LEVEL=info
HTTP_TIMEOUT_MS=45000
HTTP_MAX_RETRIES=4
HTTP_USER_AGENT=AfricaFundsMarketCollector/0.2 (+https://sadiaaf.wealthtechinnovations.com)
SCHEDULER_TIMEZONE=Europe/Paris
# Start disabled; enable only after source licensing and adapter verification.
ENABLE_SCHEDULER=false
DAILY_INGEST_CRON=30 21 * * 1-5
WEEKLY_DISCOVERY_CRON=15 2 * * 0
MONTHLY_SOURCE_AUDIT_CRON=0 3 1 * *
BACKFILL_BATCH_DAYS=90
MAX_CONCURRENT_SOURCES=2
API_HOST=0.0.0.0
API_PORT=8080
DASHBOARD_ORIGINS=https://sadiaaf.wealthtechinnovations.com
API_BIND_PORT=8891
WEB_BIND_PORT=8892
